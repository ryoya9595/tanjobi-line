# ===== LINE（通知用に新しく作った公式アカウントのもの）=====

# チャネルシークレット（LINE Developers → チャネル基本設定）
LINE_CHANNEL_SECRET=

# チャネルアクセストークン（長期）（LINE Developers → Messaging API設定）
# ※ GitHub Secrets の LINE_CHANNEL_ACCESS_TOKEN と同じ値
LINE_CHANNEL_ACCESS_TOKEN=

# 操作を受け付けるユーザーID（本人だけ。これ以外からのメッセージは黙って無視する）
# ※ GitHub Secrets の LINE_TO_USER_ID と同じ値
ALLOWED_USER_ID=

# ===== GitHub =====

# 台帳を読み書きする PAT
#   Fine-grained: 対象リポジトリに Contents（Read and write）と Actions（Read and write）
#   Classic:      repo スコープ
GITHUB_TOKEN=

# 台帳を置いているリポジトリ（owner/repo）。必ず private にすること
GITHUB_REPO=

# 任意（既定値があるので通常は空でよい）
GITHUB_BRANCH=main
CSV_PATH=data/customers.csv
WORKFLOW_FILE=birthday.yml
